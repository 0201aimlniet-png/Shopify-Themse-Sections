{%- liquid
  assign s = section.settings
  assign sec_id = section.id
  assign cols = s.columns | plus: 0
  assign img_count = section.blocks.size

  comment
    Derived values — these used to be their own theme settings, but the schema
    hit theme-check's 40-setting cap. Anything that can sensibly key off an
    existing setting is now computed here instead, which keeps the settings
    panel manageable without losing any behaviour.
  endcomment
  assign pad_y_mobile = s.padding_y | times: 0.6 | round
  assign content_gap_mobile = s.content_gap | times: 0.6 | round
  assign media_h_mobile = s.media_height | times: 0.55 | round
  assign img_gap_mobile = s.image_gap | times: 0.6 | round
  assign img_half_gap = s.image_gap | divided_by: 2
  assign img_half_gap_mobile = img_gap_mobile | divided_by: 2
  assign content_gap_tablet = s.content_gap | times: 0.6 | round
-%}

{%- style -%}
    #Spotlight-{{ sec_id }} {
    grid-column: 1 / -1;
    width: 100%;
    max-width: 100%;
    }
    #Spotlight-{{ sec_id }} .sp-link:hover,
  #Spotlight-{{ sec_id }} .sp-link:focus-visible {
    background-color: #ffffff;
    color: #000000;
    padding: 14px;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
  }
   #Spotlight-{{ sec_id }} {
     --sp-bg: {{ s.section_bg }};
     --sp-heading-color: {{ s.heading_color }};
     --sp-heading-size: {{ s.heading_size }}px;
     --sp-desc-color: {{ s.description_color }};

     --sp-hl-bg: {{ s.highlight_bg }};

     --sp-badge-bg: {{ s.badge_bg }};
     --sp-badge-color: {{ s.badge_color }};

     --sp-btn-bg: {{ s.button_bg }};
     --sp-btn-color: {{ s.button_color }};
     --sp-btn-radius: {{ s.button_radius }}px;

     --sp-media-h: {{ s.media_height }}px;
     --sp-media-h-mobile: {{ media_h_mobile }}px;
     --sp-img-radius: {{ s.image_radius }}px;
     --sp-img-gap: {{ s.image_gap }}px;
     --sp-half-gap: {{ img_half_gap }}px;
     --sp-col-gap: {{ s.image_gap }}px;
     --sp-speed: {{ s.scroll_speed }}s;

     --sp-max-width: {{ s.max_width }}px;
     --sp-pad-x: {{ s.padding_x }}px;
     --sp-gap: {{ s.content_gap }}px;

     background: var(--sp-bg);
     color: var(--sp-heading-color);
     overflow: hidden;
   }

   #Spotlight-{{ sec_id }},
   #Spotlight-{{ sec_id }} * { box-sizing: border-box; }

   #Spotlight-{{ sec_id }} .sp-grid {
     max-width: var(--sp-max-width);
     margin: 0 auto;
     display: grid;
     grid-template-columns: 1fr 1fr;
     align-items: center;
     gap: var(--sp-gap);
   }

   /* Media sits on the right by default and flips to the left via the layout
      setting. Only the CSS `order` swaps — never the markup — so the text block
      always comes first in the DOM for screen readers, and the mobile
      "text above images" stacking works in both layouts for free. */
   #Spotlight-{{ sec_id }} .sp-content {
     order: 1;
     padding: {{ s.padding_y }}px 0;
     padding-inline-start: var(--sp-pad-x);
   }
   #Spotlight-{{ sec_id }} .sp-media { order: 2; }

   #Spotlight-{{ sec_id }}[data-media-position="left"] .sp-content {
     order: 2;
     padding-inline-start: 0;
     padding-inline-end: var(--sp-pad-x);
   }
   #Spotlight-{{ sec_id }}[data-media-position="left"] .sp-media { order: 1; }

   /* ---------- Content ---------- */
   #Spotlight-{{ sec_id }} .sp-inner { max-width: 560px; }
   #Spotlight-{{ sec_id }}[data-media-position="left"] .sp-inner { margin-left: auto; }

   #Spotlight-{{ sec_id }} .sp-badge {
     display: inline-flex;
     align-items: center;
     gap: 8px;
     background: var(--sp-badge-bg);
     color: var(--sp-badge-color);
     padding: 9px 18px;
     border-radius: 999px;
     font-size: 15px;
     font-weight: 600;
     margin-bottom: 28px;
   }
   #Spotlight-{{ sec_id }} .sp-badge svg {
     width: 15px;
     height: 15px;
     fill: currentColor;
     flex: 0 0 auto;
   }

   #Spotlight-{{ sec_id }} .sp-heading {
     margin: 0 0 22px;
     font-size: clamp(34px, 5.4vw, var(--sp-heading-size));
     font-weight: 800;
     line-height: 1.08;
     letter-spacing: -0.02em;
     color: var(--sp-heading-color);
   }

   /* The highlighted line gets a solid block behind it. inline-block plus
      box-decoration-break keeps that block tight to the text even if the line
      wraps onto two rows. */
   #Spotlight-{{ sec_id }} .sp-highlight {
     display: inline-block;
     background: var(--sp-hl-bg);
     padding: 0.06em 0.22em;
     border-radius: 2px;
     -webkit-box-decoration-break: clone;
     box-decoration-break: clone;
   }

   #Spotlight-{{ sec_id }} .sp-description {
     margin: 0 0 34px;
     font-size: clamp(15px, 2.1vw, 18px);
     font-weight: 500;
     line-height: 1.55;
     color: var(--sp-desc-color);
   }
   #Spotlight-{{ sec_id }} .sp-description p { margin: 0 0 0.5em; }
   #Spotlight-{{ sec_id }} .sp-description p:last-child { margin-bottom: 0; }

   /* ---------- Buttons ---------- */
   #Spotlight-{{ sec_id }} .sp-actions {
     display: flex;
     align-items: center;
     gap: 18px;
     flex-wrap: wrap;
   }
   #Spotlight-{{ sec_id }} .sp-btn:hover {
  background: #ffffff;
  color: #000000;

  transform:
    translateY(-3px);

  box-shadow: 0 14px 30px rgba(11, 29, 85, 0.24);
}

#Spotlight-{{ sec_id }} .sp-btn:hover::before {
  transform:
    translateX(100%);
}

#Spotlight-{{ sec_id }} .sp-btn:active {
  transform:
    translateY(-1px);

  box-shadow:
    0 6px 16px rgba(0, 0, 0, 0.14);
}

@media (prefers-reduced-motion: reduce) {

  #Spotlight-{{ sec_id }} .sp-btn,
  #Spotlight-{{ sec_id }} .sp-btn::before {
    transition: none;
  }

}
   #Spotlight-{{ sec_id }} .sp-btn {
     display: inline-flex;
     align-items: center;
     justify-content: center;
     background: var(--sp-btn-bg);
     color: var(--sp-btn-color);
     border-radius: var(--sp-btn-radius);
     padding: 15px 28px;
     font-size: 17px;
     font-weight: 700;
     text-decoration: none;
     transition: transform 0.25s ease, opacity 0.25s ease;
   }
   #Spotlight-{{ sec_id }} .sp-btn:hover {
     transform: translateY(-2px);
     opacity: 0.92;
   }

   #Spotlight-{{ sec_id }} .sp-link {
     display: inline-flex;
     align-items: center;
     gap: 9px;
     color: var(--sp-heading-color);
     font-size: 17px;
     font-weight: 700;
     text-decoration: none;
   }

   /* Arrow starts diagonal (up-right) and straightens to horizontal on hover,
      then eases back when the pointer leaves. */
   #Spotlight-{{ sec_id }} .sp-link-arrow {
     display: inline-flex;
     transform: rotate(-45deg);
     transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
   }
   #Spotlight-{{ sec_id }} .sp-link-arrow svg {
     width: 17px;
     height: 17px;
     display: block;
   }
   #Spotlight-{{ sec_id }} .sp-link:hover .sp-link-arrow,
   #Spotlight-{{ sec_id }} .sp-link:focus-visible .sp-link-arrow {
     transform: rotate(0deg);
   }

   /* ---------- Media columns ---------- */
   #Spotlight-{{ sec_id }} .sp-media {
     position: relative;
     height: var(--sp-media-h);
     display: grid;
     grid-template-columns: repeat({{ cols }}, 1fr);
     gap: var(--sp-col-gap);
     overflow: hidden;
   }

   #Spotlight-{{ sec_id }}[data-fade-edges="true"] .sp-media {
     -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 12%, #000 88%, transparent 100%);
     mask-image: linear-gradient(to bottom, transparent 0, #000 12%, #000 88%, transparent 100%);
   }

   #Spotlight-{{ sec_id }} .sp-col {
     position: relative;
     overflow: hidden;
   }

   #Spotlight-{{ sec_id }} .sp-track {
     display: flex;
     flex-direction: column;
     gap: var(--sp-img-gap);
     will-change: transform;
   }

   #Spotlight-{{ sec_id }}[data-animate="true"] .sp-track {
     animation-name: sp-scroll;
     animation-duration: var(--sp-speed);
     animation-timing-function: linear;
     animation-iteration-count: infinite;
   }

   /* Alternating direction: "up" columns run the keyframes forward, "down"
      columns run the same keyframes in reverse — same speed, opposite travel.
      Each track holds two copies of its images, so scrolling exactly one
      copy's height loops seamlessly. */
   #Spotlight-{{ sec_id }} .sp-col[data-direction="down"] .sp-track {
     animation-direction: reverse;
   }

   @keyframes sp-scroll {
     from { transform: translateY(0); }
     to { transform: translateY(calc(-50% - var(--sp-half-gap))); }
   }

   #Spotlight-{{ sec_id }}[data-pause-hover="true"] .sp-media:hover .sp-track {
     animation-play-state: paused;
   }

   #Spotlight-{{ sec_id }} .sp-figure {
     margin: 0;
     flex: 0 0 auto;
     border-radius: var(--sp-img-radius);
     overflow: hidden;
     background: rgba(255,255,255,0.06);
     aspect-ratio: {{ s.image_aspect_ratio }};
   }

   #Spotlight-{{ sec_id }} .sp-figure img {
     width: 100%;
     height: 100%;
     object-fit: cover;
     display: block;
   }

   #Spotlight-{{ sec_id }} .sp-figure .sp-placeholder-svg {
     width: 100%;
     height: 100%;
     display: block;
     background: rgba(255,255,255,0.08);
   }

   /* ---------- Tablet ---------- */
   @media screen and (max-width: 989px) {
     #Spotlight-{{ sec_id }} {
       --sp-gap: {{ content_gap_tablet }}px;
     }
     #Spotlight-{{ sec_id }} .sp-heading { font-size: clamp(30px, 5vw, 44px); }
   }

   /* ---------- Mobile: stack with text first ---------- */
   @media screen and (max-width: 990px) {
     #Spotlight-{{ sec_id }} {
       --sp-pad-x: 20px;
       --sp-col-gap: {{ img_gap_mobile }}px;
       --sp-img-gap: {{ img_gap_mobile }}px;
       --sp-half-gap: {{ img_half_gap_mobile }}px;
     }

     #Spotlight-{{ sec_id }} .sp-grid {
       grid-template-columns: 1fr;
       gap: {{ content_gap_mobile }}px;
     }

     #Spotlight-{{ sec_id }} .sp-content,
     #Spotlight-{{ sec_id }}[data-media-position="left"] .sp-content {
       order: 1;
       padding: {{ pad_y_mobile }}px var(--sp-pad-x) 0;
     }
     #Spotlight-{{ sec_id }} .sp-media,
     #Spotlight-{{ sec_id }}[data-media-position="left"] .sp-media {
       order: 2;
       height: var(--sp-media-h-mobile);
       padding: 0 var(--sp-pad-x) {{ pad_y_mobile }}px;
       overflow: visible;
     }
     #Spotlight-{{ sec_id }} .sp-inner,
     #Spotlight-{{ sec_id }}[data-media-position="left"] .sp-inner {
       max-width: 100%;
       margin-left: 0;
     }

     #Spotlight-{{ sec_id }} .sp-badge { margin-bottom: 20px; }
     #Spotlight-{{ sec_id }} .sp-heading { margin-bottom: 16px; }
     #Spotlight-{{ sec_id }} .sp-description { margin-bottom: 26px; }
     #Spotlight-{{ sec_id }} .sp-actions { gap: 14px; }
   }

   @media (prefers-reduced-motion: reduce) {
     #Spotlight-{{ sec_id }} .sp-track { animation: none !important; }
     #Spotlight-{{ sec_id }} .sp-link-arrow,
     #Spotlight-{{ sec_id }} .sp-btn { transition: none !important; }
   }
   #Spotlight-{{ sec_id }} .sp-caption {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 12px;
    flex: 0 0 auto;
  }

  #Spotlight-{{ sec_id }} .sp-caption-avatar {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.1);
  }

  #Spotlight-{{ sec_id }} .sp-caption-avatar img,
  #Spotlight-{{ sec_id }} .sp-caption-placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #Spotlight-{{ sec_id }} .sp-caption-body {
    min-width: 0;
  }

  #Spotlight-{{ sec_id }} .sp-caption-title {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--sp-heading-color);
  }

  #Spotlight-{{ sec_id }} .sp-caption-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 500;
    color: var(--sp-desc-color);
    opacity: 0.85;
  }
  #Spotlight-{{ sec_id }} .sp-media {
    padding-right: 8%;
  }

  @media screen and (max-width: 990px) {
    #Spotlight-{{ sec_id }} .sp-media {
      padding-right: 0;
    }
  }
  #Spotlight-{{ sec_id }} .sp-figure img {
    transition: transform 0.4s ease;
  }
  #Spotlight-{{ sec_id }} .sp-media:hover .sp-figure img {
    transform: scale(1.03);
  }
  #Spotlight-{{ sec_id }} .sp-caption {
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  #Spotlight-{{ sec_id }} .sp-caption:hover {
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18);
    transform: translateY(-2px);
  }
  #Spotlight-{{ sec_id }} .sp-caption-text {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  #Spotlight-{{ sec_id }} .sp-caption-avatar {
    border-radius: calc(var(--sp-img-radius) * 0.6);
  }
  #Spotlight-{{ sec_id }} .sp-figure,
  #Spotlight-{{ sec_id }} .sp-caption {
    opacity: 0;
    animation: sp-fade-in 0.6s ease forwards;
  }
  @keyframes sp-fade-in {
    to { opacity: 1; }
  }
  #Spotlight-{{ sec_id }} .sp-figure {
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .sp-media {
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.10),
      0 2px 8px rgba(0, 0, 0, 0.06);
  }
{%- endstyle -%}

<div
  id="Spotlight-{{ sec_id }}"
  data-media-position="{{ s.media_position }}"
  data-animate="{{ s.enable_scroll }}"
  data-pause-hover="{{ s.pause_on_hover }}"
  data-fade-edges="{{ s.fade_edges }}"
>
  <div class="sp-grid">
    <div class="sp-content">
      <div class="sp-inner">
        {%- if s.badge_text != blank -%}
          <div class="sp-badge">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            <span>{{ s.badge_text }}</span>
          </div>
        {%- endif -%}

        {%- if s.heading != blank or s.heading_highlight != blank -%}
          <h2 class="sp-heading">
            {%- if s.heading != blank -%}{{ s.heading }}{%- endif -%}
            {%- if s.heading_highlight != blank -%}
              {%- if s.heading != blank -%}<br>{%- endif -%}
              <span class="sp-highlight">{{ s.heading_highlight }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if s.description != blank -%}
          <div class="sp-description">{{ s.description }}</div>
        {%- endif -%}

        {%- if s.button_label != blank or s.link_label != blank -%}
          <div class="sp-actions">
            {%- if s.button_label != blank -%}
              <a class="sp-btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>
            {%- endif -%}
            {%- if s.link_label != blank -%}
              <a class="sp-link" href="{{ s.link_link | default: '#' }}">
                <span>{{ s.link_label }}</span>
                <span class="sp-link-arrow" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="sp-media">
      {%- comment -%}
        Images are distributed across the columns round-robin (image 1 to col 1,
        image 2 to col 2, image 3 to col 1 and so on), so a merchant just adds
        image blocks and they spread out evenly without picking a column each
        time.
      {%- endcomment -%}
      {%- for col in (1..cols) -%}
        {%- liquid
          assign col_index = col | minus: 1
          assign dir = 'up'
          assign parity = col_index | modulo: 2
          if s.first_column_direction == 'down'
            if parity == 0
              assign dir = 'down'
            endif
          else
            if parity == 1
              assign dir = 'down'
            endif
          endif
        -%}
        <div class="sp-col" data-direction="{{ dir }}">
          <div class="sp-track">
            {%- comment -%} Two passes give the seamless vertical loop. {%- endcomment -%}
            {%- for pass in (1..2) -%}
              {%- if img_count > 0 -%}
                {%- for block in section.blocks -%}
                  {%- assign slot = forloop.index0 | modulo: cols -%}
                  {%- if slot == col_index -%}
                    {%- if block.settings.image != blank -%}
                      <figure
                        class="sp-figure"
                        {% if pass == 1 %}
                          {{- block.shopify_attributes -}}
                        {% else %}
                          aria-hidden="true"
                        {% endif %}
                      >
                        <img
                          src="{{ block.settings.image | image_url: width: 800 }}"
                          srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w"
                          sizes="(max-width: 749px) 45vw, 25vw"
                          alt="{{ block.settings.image.alt | escape }}"
                          loading="lazy"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.height }}"
                        >
                      </figure>
                    {%- endif -%}

                    {%- if block.settings.show_caption and block.settings.image != blank -%}
                      <div
                        class="sp-caption"
                        style="background-color: #fff;"
                        {% if pass == 1 %}
                          {{- block.shopify_attributes -}}
                        {% else %}
                          aria-hidden="true"
                        {% endif %}
                      >
                        <div class="sp-caption-avatar">
                          {%- if block.settings.avatar_image != blank -%}
                            <img
                              src="{{ block.settings.avatar_image | image_url: width: 120 }}"
                              alt=""
                              loading="lazy"
                              width="{{ block.settings.avatar_image.width }}"
                              height="{{ block.settings.avatar_image.height }}"
                            >
                          {%- else -%}
                            {{ 'lifestyle-1' | placeholder_svg_tag: 'sp-caption-placeholder-svg' }}
                          {%- endif -%}
                        </div>
                        <div class="sp-caption-body">
                          {%- if block.settings.caption_title != blank -%}
                            <p class="sp-caption-title">{{ block.settings.caption_title }}</p>
                          {%- endif -%}
                          {%- if block.settings.caption_text != blank -%}
                            <p class="sp-caption-text">{{ block.settings.caption_text }}</p>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- comment -%} No blocks yet: show placeholders so the layout is visible in the editor. {%- endcomment -%}
                {%- for i in (1..3) -%}
                  <figure
                    class="sp-figure"
                    {% if pass == 2 %}
                      aria-hidden="true"
                    {% endif %}
                  >
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'sp-placeholder-svg' }}
                  </figure>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text with Images",
  "tag": "section",
  "class": "section section--spotlight",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "info": "Switches which side the image columns appear on. On mobile the text always sits above the images.",
      "options": [
        { "value": "right", "label": "Images right, text left" },
        { "value": "left", "label": "Images left, text right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section max width",
      "min": 1000,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1600
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between text and images",
      "info": "Reduced automatically on tablet and mobile.",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Text side padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Top and bottom padding",
      "info": "Reduced automatically on mobile.",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    { "type": "header", "content": "Badge" },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "info": "Leave blank to hide the badge.",
      "default": "5.00 from 144+ reviews"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#1e2b45"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge text and star color",
      "default": "#ffffff"
    },
    { "type": "header", "content": "Heading and text" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Prioritize Safety and Ethics in Your"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted line",
      "info": "Rendered on its own line with a solid background behind it.",
      "default": "Services Spotlight"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "info": "Scales down automatically on smaller screens.",
      "min": 30,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 62
